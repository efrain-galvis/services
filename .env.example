# Existing Railway REST service (used for starters, booking, and chat fallback).
VITE_SITE_AGENT_URL=https://site-agent-production.up.railway.app

# On Vercel, set this to the same-origin Runtime route: /api/copilotkit
# Leave blank for plain Vite development to use the existing /v1/chat fallback.
VITE_COPILOTKIT_RUNTIME_URL=
VITE_COPILOTKIT_AGENT_ID=lyra

# Optional public speed bump. This is shipped to browsers and must never be a secret.
VITE_SITE_TOKEN=

# Vercel Runtime settings. These are server-only: never prefix SITE_TOKEN with VITE_.
SITE_AGENT_URL=https://site-agent-production.up.railway.app
COPILOTKIT_AGENT_ID=lyra
SITE_TOKEN=

# Required durable per-visitor rate-limit store (server-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
